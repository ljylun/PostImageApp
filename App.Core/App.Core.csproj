<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PostImageUploader.Core</RootNamespace>
    <AssemblyName>PostImageUploader.Core</AssemblyName>
    
    <!-- NuGet Package Metadata -->
    <PackageId>PostImageUploader.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>PostImageUploader Contributors</Authors>
    <Description>A reusable library for uploading images to PostImages.org. Provides core business logic without any CLI or hosting dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>postimage;uploader;image-hosting;upload</PackageTags>
    <RepositoryUrl>https://github.com/example/PostImageUploader</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
